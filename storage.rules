rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function listing(listingId) {
      return firestore.get(/databases/(default)/documents/listings/$(listingId)).data;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/listings/{listingId}/{fileName} {
      allow read: if listing(listingId).status == 'active' || (isOwner(uid) && listing(listingId).sellerId == uid);
      allow create, update: if isOwner(uid)
        && listing(listingId).sellerId == uid
        && listing(listingId).status in ['draft', 'active']
        && validImage();
      allow delete: if isOwner(uid) && listing(listingId).sellerId == uid;
    }
  }
}

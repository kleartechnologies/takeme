rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // BEGIN GENERATED RELEASE POLICY — functions/src/release-policy.ts
    function configuredAcceptance(acceptance) {
      return acceptance.termsAcceptedAt is timestamp && acceptance.privacyAcceptedAt is timestamp
        && acceptance.age18ConfirmedAt is timestamp && acceptance.acceptanceSource == 'web'
        && (!('revokedAt' in acceptance) || acceptance.revokedAt == null)
        && ((request.auth.token.aud == 'demo-takeme' && acceptance.termsVersion == "1.0-draft"
          && acceptance.privacyVersion == "1.0-draft")
          || (request.auth.token.aud == "takeme-staging-822a5" && acceptance.termsVersion == "1.0-staging"
            && acceptance.privacyVersion == "1.0-staging")
          || (request.auth.token.aud == "takeme-52b80" && acceptance.termsVersion == "1.0" && acceptance.privacyVersion == "1.0"));
    }
    function configuredReleasePolicy(policy) {
      return policy.publicationApproved == true && policy.minimumAge == 18
        && policy.projectId == request.auth.token.aud
        && ((policy.releaseTarget == 'demo' && policy.projectId == 'demo-takeme'
            && policy.termsVersion == "1.0-draft" && policy.privacyVersion == "1.0-draft")
          || (policy.releaseTarget == 'staging' && policy.projectId == "takeme-staging-822a5"
            && policy.termsVersion == "1.0-staging" && policy.privacyVersion == "1.0-staging")
          || (policy.releaseTarget == 'production' && policy.projectId == "takeme-52b80"
            && policy.keys().hasAll(['releaseTarget', 'projectId', 'publicationApproved', 'termsVersion', 'privacyVersion', 'minimumAge'])
            && policy.keys().hasOnly(['releaseTarget', 'projectId', 'publicationApproved', 'termsVersion', 'privacyVersion', 'minimumAge'])
            && policy.termsVersion == "1.0" && policy.privacyVersion == "1.0"));
    }
    function configuredStorageBucket(name) {
      return (request.auth.token.aud == "takeme-staging-822a5" && name == "takeme-staging-822a5.firebasestorage.app")
        || (request.auth.token.aud == "takeme-52b80" && name == "takeme-52b80.firebasestorage.app")
        || (request.auth.token.aud != "takeme-staging-822a5" && request.auth.token.aud != "takeme-52b80"
          && name in [request.auth.token.aud + '.appspot.com', request.auth.token.aud + '.firebasestorage.app']);
    }
    // END GENERATED RELEASE POLICY
    function signedIn() { return request.auth != null && !firestore.exists(/databases/(default)/documents/accountLifecycles/$(request.auth.uid)); }
    // Acceptance is removed atomically when deletion starts, so writes need only
    // this owner document and (for listing media) the existing listing document.
    // Maintenance blocks new permits in Functions. Listing uploads already use
    // both cross-service document accesses, so no third global-control lookup
    // is added here. Existing permit leases can remain usable for 120 seconds;
    // eligible owner cleanup/deletes remain allowed and are not permit-bound.
    function eligibleOwner(uid) {
      let acceptance = firestore.get(/databases/(default)/documents/users/$(uid)/private/onboarding).data;
      return request.auth != null && request.auth.uid == uid && configuredAcceptance(acceptance)
        && configuredStorageBucket(bucket);
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage() {
      return request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // The existing acceptance lookup is reused, preserving the two-document limit.
    function validUploadPermit(uid, path) {
      let acceptance = firestore.get(/databases/(default)/documents/users/$(uid)/private/onboarding).data;
      let permitId = request.resource.metadata.takemeUploadPermit;
      let permit = acceptance.uploadPermits[permitId];
      return permitId is string && permit.path == path
        && permit.contentType == request.resource.contentType
        && permit.sizeBytes == request.resource.size
        && permit.expiresAt is timestamp && request.time < permit.expiresAt;
    }
    function listing(listingId) {
      return firestore.get(/databases/(default)/documents/listings/$(listingId)).data;
    }
    function canManageListingMedia(uid, listingId) {
      return eligibleOwner(uid)
        && listing(listingId).sellerId == uid
        && (
          (listing(listingId).listingType == 'buy_now' && listing(listingId).status in ['draft', 'active'])
          || (listing(listingId).listingType in ['auction', 'buy_now_and_auction']
            && listing(listingId).bidCount == 0
            && (listing(listingId).status == 'draft'
              || (listing(listingId).auctionStatus == 'scheduled' && request.time < listing(listingId).auctionStartAt)))
        );
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow create: if resource == null && eligibleOwner(uid) && validImage()
        && validUploadPermit(uid, "users/" + uid + "/profile/" + fileName);
      // An upload permit cannot be replayed to overwrite an existing object.
      allow update: if false;
      allow delete: if eligibleOwner(uid);
    }

    match /users/{uid}/listings/{listingId}/{fileName} {
      allow read: if listing(listingId).sellerId == uid
        && (listing(listingId).status in ['active', 'ended']
          || (listing(listingId).status == 'sold'
            && listing(listingId).listingType == 'buy_now'
            && listing(listingId).privacyVersion == 2)
          || isOwner(uid));
      allow create: if resource == null && canManageListingMedia(uid, listingId) && validImage()
        && validUploadPermit(uid, "users/" + uid + "/listings/" + listingId + "/" + fileName);
      allow update: if false;
      allow delete: if canManageListingMedia(uid, listingId);
    }
  }
}

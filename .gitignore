# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/functions/lib
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Local credential-bearing fixtures and generated verification artifacts
/tests/stage11-ui-fixture.mjs
/tests/messaging-ui-fixture.mjs
/.local-verification/

# next.js
/.next/
/out/
/.open-next/
/.wrangler/
/.dev.vars*
/cloudflare-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Firebase emulator and CLI logs
firebase-debug.log
firestore-debug.log
ui-debug.log
functions-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Explicit local-only profiling, evidence and export directories
/.qualification-output/
/.profiling-output/
/.screenshots/
/.emulator-exports/
/.release-bundles/
/.private-receipts/
*.cpuprofile
*.heapprofile
*.heapsnapshot
*.p12
*.pfx

# Isolated server-side media processor dependencies
/media-processor/node_modules/

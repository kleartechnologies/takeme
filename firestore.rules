rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function parentListing(listingId) { return get(/databases/$(database)/documents/listings/$(listingId)).data; }
    function transactionData(transactionId) { return get(/databases/$(database)/documents/transactions/$(transactionId)).data; }
    function transactionParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }
    function conversationParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }
    function publicProfileSafe(data, uid) {
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['uid', 'displayName', 'photoURL', 'location'])
        && data.uid == uid;
    }
    function validPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && (data.photoURL == null || data.photoURL is string)
        && data.location is string
        && data.location.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      // Firestore returns complete documents: a legacy/admin-added private field
      // must not leak through the public profile path.
      allow get: if owns(uid) || publicProfileSafe(resource.data, uid);
      allow list: if false;
      allow create: if owns(uid) && validPublicProfile(request.resource.data, uid);
      allow update: if (owns(uid)
          && validPublicProfile(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if isAdmin();

      match /saved/{listingId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && request.query.limit <= 13;
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll(['listingId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['listingId', 'savedAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && parentListing(listingId).status == 'active';
        allow delete: if owns(uid);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read, write: if false;
      }
      match /following/{sellerId} {
        allow read, write: if false;
      }
    }

    match /listings/{listingId} {
      allow get: if resource.data.status in ['active', 'ended', 'sold']
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
      allow list: if resource.data.status in ['active', 'ended']
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
      allow create, update, delete: if isAdmin();

      match /bids/{bidId} {
        allow read: if parentListing(listingId).status in ['active', 'ended']
          || (signedIn() && parentListing(listingId).sellerId == request.auth.uid)
          || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /favorites/{favoriteId} { allow read, write: if false; }

    match /transactions/{transactionId} {
      allow get: if transactionParticipant(resource.data) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
      match /reviews/{reviewerUid} {
        allow get: if isAdmin() || (owns(reviewerUid) && transactionParticipant(transactionData(transactionId)));
        allow list: if false;
        allow create, update, delete: if false;
      }
    }
    match /offers/{offerId} { allow read, write: if false; }
    match /offerLocks/{lockId} { allow read, write: if false; }
    match /listingDeals/{listingId} { allow read, write: if false; }
    match /publicReviews/{reviewId} { allow read, write: if false; }
    match /trustSummaries/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    // Protected-payment records are never client-authoritative. Participants and
    // administrators receive explicit safe projections through callable Functions.
    match /protectedPayments/{transactionId} { allow read, write: if false; }
    match /payouts/{transactionId} { allow read, write: if false; }
    match /refunds/{refundId} { allow read, write: if false; }
    match /sellerPaymentProfiles/{uid} { allow read, write: if false; }
    match /transactionDisputes/{transactionId} {
      allow read, write: if false;
      match /evidence/{evidenceId} { allow read, write: if false; }
    }
    match /transactionEvents/{eventId} { allow read, write: if false; }
    match /paymentProviderEvents/{eventId} { allow read, write: if false; }
    match /marketplaceEvents/{eventId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /userInterests/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /listingTrends/{listingId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /intelligenceQuotas/{quotaId} {
      allow read, write: if false;
    }
    match /discoverySessions/{sessionId} {
      allow read, write: if false;
    }
    match /intelligenceCompletions/{transactionId} {
      allow read, write: if false;
    }
    match /discoveryAttributions/{attributionId} {
      allow read, write: if false;
    }
    match /promotionPackages/{packageId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 20;
      allow create, update, delete: if isAdmin();
    }
    match /promotions/{promotionId} {
      allow get: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /promotionLocks/{listingId} {
      allow read, write: if false;
    }
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /auctions/{id} { allow read, write: if false; }
    match /bids/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /reviews/{id} { allow read, write: if false; }
    match /messages/{id} { allow read, write: if false; }
    match /boosts/{id} { allow read, write: if false; }
    match /featuredListings/{id} { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }
    match /notificationSummaries/{uid} { allow read, write: if false; }
    match /notificationPreferences/{uid} { allow read, write: if false; }
    match /sellerFollowers/{sellerId} {
      allow read, write: if false;
      match /members/{uid} { allow read, write: if false; }
    }
    match /sellerFollowSummaries/{sellerId} { allow read, write: if false; }
    match /savedSearches/{searchId} { allow read, write: if false; }
    match /savedSearchQuotas/{uid} { allow read, write: if false; }
    match /savedSearchFingerprints/{fingerprintId} { allow read, write: if false; }
    match /listingWatchers/{listingId} {
      allow read, write: if false;
      match /users/{uid} { allow read, write: if false; }
    }
    match /listingPriceHistory/{listingId} {
      allow read, write: if false;
      match /changes/{changeId} { allow read, write: if false; }
    }
    match /engagementJobs/{jobId} { allow read, write: if false; }
    match /engagementSchedulerCursors/{cursorId} { allow read, write: if false; }
  }
}

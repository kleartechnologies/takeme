rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function parentListing(listingId) { return get(/databases/$(database)/documents/listings/$(listingId)).data; }
    function transactionData(transactionId) { return get(/databases/$(database)/documents/transactions/$(transactionId)).data; }
    function conversationData(conversationId) { return get(/databases/$(database)/documents/conversations/$(conversationId)).data; }
    function transactionParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }
    function conversationParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }

    function validPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && (data.photoURL == null || data.photoURL is string)
        && data.location is string
        && data.location.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCommonListing(data, listingId) {
      return data.keys().hasAll(['id', 'sellerId', 'title', 'description', 'categoryId', 'condition', 'price', 'listingType', 'location', 'locationKey', 'imageUrls', 'searchTokens', 'facetKeys', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'sellerId', 'title', 'description', 'categoryId', 'condition', 'price', 'listingType', 'location', 'locationKey', 'latitude', 'longitude', 'imageUrls', 'searchTokens', 'facetKeys', 'status', 'createdAt', 'updatedAt', 'auctionStartAt', 'auctionEndAt', 'startingBid', 'currentBid', 'currentBidderId', 'bidCount', 'minimumBidIncrement', 'auctionStatus', 'winnerId', 'finalBid', 'endedAt'])
        && data.id == listingId
        && data.sellerId is string
        && data.title is string && data.title.size() >= 6 && data.title.size() <= 80
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 1200
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 60
        && data.condition in ['New', 'Like new', 'Good', 'Fair']
        && (data.price is int || data.price is float) && data.price > 0 && data.price <= 10000000
        && data.listingType in ['buy_now', 'auction', 'buy_now_and_auction']
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 120
        && data.locationKey is string && data.locationKey.size() <= 120
        && (!data.keys().hasAny(['latitude']) || (data.latitude is int || data.latitude is float))
        && (!data.keys().hasAny(['longitude']) || (data.longitude is int || data.longitude is float))
        && data.imageUrls is list && data.imageUrls.size() <= 8
        && data.searchTokens is list && data.searchTokens.size() <= 100
        && data.facetKeys is list && data.facetKeys.size() <= 16
        && data.status in ['draft', 'active', 'sold', 'ended', 'removed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasAuctionFields(data) {
      return data.keys().hasAll(['auctionStartAt', 'auctionEndAt', 'startingBid', 'currentBid', 'currentBidderId', 'bidCount', 'minimumBidIncrement', 'auctionStatus', 'winnerId', 'finalBid', 'endedAt']);
    }

    function validAuctionListing(data) {
      return data.listingType in ['auction', 'buy_now_and_auction']
        && hasAuctionFields(data)
        && data.auctionStartAt is timestamp
        && data.auctionEndAt is timestamp
        && data.auctionEndAt > data.auctionStartAt
        && data.startingBid is int && data.startingBid > 0 && data.startingBid <= 1000000000
        && data.minimumBidIncrement is int && data.minimumBidIncrement > 0 && data.minimumBidIncrement <= 1000000000
        && data.currentBid is int && data.currentBid >= 0 && data.currentBid <= 1000000000
        && data.bidCount is int && data.bidCount >= 0
        && (data.currentBidderId == null || data.currentBidderId is string)
        && data.auctionStatus in ['scheduled', 'active', 'ended', 'cancelled']
        && (data.winnerId == null || data.winnerId is string)
        && (data.finalBid == null || (data.finalBid is int && data.finalBid > 0))
        && (data.endedAt == null || data.endedAt is timestamp)
        && ((data.bidCount == 0 && data.currentBid == 0 && data.currentBidderId == null)
          || (data.bidCount > 0 && data.currentBid >= data.startingBid && data.currentBidderId is string));
    }

    function validBuyNowListing(data) {
      return data.listingType == 'buy_now'
        && !data.keys().hasAny(['auctionStartAt', 'auctionEndAt', 'startingBid', 'currentBid', 'currentBidderId', 'bidCount', 'minimumBidIncrement', 'auctionStatus', 'winnerId', 'finalBid', 'endedAt']);
    }

    function validListing(data, listingId) {
      return validCommonListing(data, listingId)
        && (validBuyNowListing(data) || validAuctionListing(data));
    }

    function buyNowOwnerUpdateAllowed() {
      return signedIn()
        && resource.data.listingType == 'buy_now'
        && request.resource.data.listingType == 'buy_now'
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'categoryId', 'condition', 'price', 'location', 'locationKey', 'latitude', 'longitude', 'imageUrls', 'searchTokens', 'facetKeys', 'status', 'updatedAt'])
        && ((resource.data.status == 'draft' && request.resource.data.status in ['draft', 'active', 'removed'])
          || (resource.data.status == 'active' && request.resource.data.status in ['active', 'removed'])
          || (resource.data.status == 'removed' && request.resource.data.status == 'removed'))
        && (request.resource.data.status != 'active' || request.resource.data.imageUrls.size() >= 1);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if owns(uid) && validPublicProfile(request.resource.data, uid);
      allow update: if (owns(uid)
          && validPublicProfile(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if isAdmin();

      match /saved/{listingId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && request.query.limit <= 13;
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll(['listingId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['listingId', 'savedAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && parentListing(listingId).status == 'active';
        allow delete: if owns(uid);
        allow update: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if resource.data.status in ['active', 'ended']
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.listingType == 'buy_now'
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.imageUrls.size() == 0
        && validListing(request.resource.data, listingId);
      allow update: if (buyNowOwnerUpdateAllowed() && validListing(request.resource.data, listingId)) || isAdmin();
      allow delete: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'draft'
        && (resource.data.listingType == 'buy_now' || resource.data.bidCount == 0)
        || isAdmin();

      match /bids/{bidId} {
        allow read: if parentListing(listingId).status in ['active', 'ended']
          || (signedIn() && parentListing(listingId).sellerId == request.auth.uid)
          || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /favorites/{favoriteId} { allow read, write: if false; }

    match /transactions/{transactionId} {
      allow get: if transactionParticipant(resource.data) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
      match /reviews/{reviewerUid} {
        allow get, list: if transactionParticipant(transactionData(transactionId)) || isAdmin();
        allow create: if owns(reviewerUid)
          && transactionData(transactionId).status == 'completed'
          && transactionData(transactionId).buyerId != transactionData(transactionId).sellerId
          && transactionParticipant(transactionData(transactionId))
          && request.resource.data.keys().hasAll(['transactionId', 'buyerId', 'sellerId', 'reviewerId', 'reviewedUserId', 'rating', 'comment', 'createdAt'])
          && request.resource.data.keys().hasOnly(['transactionId', 'buyerId', 'sellerId', 'reviewerId', 'reviewedUserId', 'rating', 'comment', 'createdAt'])
          && request.resource.data.transactionId == transactionId
          && request.resource.data.buyerId == transactionData(transactionId).buyerId
          && request.resource.data.sellerId == transactionData(transactionId).sellerId
          && request.resource.data.reviewerId == reviewerUid
          && request.resource.data.reviewedUserId == (reviewerUid == transactionData(transactionId).buyerId ? transactionData(transactionId).sellerId : transactionData(transactionId).buyerId)
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /trustSummaries/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /marketplaceEvents/{eventId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /userInterests/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /listingTrends/{listingId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /intelligenceQuotas/{quotaId} {
      allow read, write: if false;
    }
    match /conversations/{conversationId} {
      allow get: if conversationParticipant(resource.data) || isAdmin();
      allow list: if (signedIn() && request.auth.uid in resource.data.participants || isAdmin()) && request.query.limit <= 20;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'listingId', 'buyerId', 'sellerId', 'participants', 'latestMessage', 'unreadBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'listingId', 'buyerId', 'sellerId', 'participants', 'latestMessage', 'unreadBy', 'createdAt', 'updatedAt'])
        && request.resource.data.id == conversationId
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.listingId is string
        && conversationId == request.resource.data.listingId + '_' + request.auth.uid
        && parentListing(request.resource.data.listingId).status == 'active'
        && parentListing(request.resource.data.listingId).sellerId == request.resource.data.sellerId
        && request.resource.data.participants == [request.auth.uid, request.resource.data.sellerId]
        && request.resource.data.latestMessage == null
        && request.resource.data.unreadBy is map
        && request.resource.data.unreadBy.keys().hasAll([request.auth.uid, request.resource.data.sellerId])
        && request.resource.data.unreadBy.keys().hasOnly([request.auth.uid, request.resource.data.sellerId])
        && request.resource.data.unreadBy[request.auth.uid] == 0
        && request.resource.data.unreadBy[request.resource.data.sellerId] == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow get: if conversationParticipant(conversationData(conversationId)) || isAdmin();
        allow list: if (conversationParticipant(conversationData(conversationId)) || isAdmin()) && request.query.limit <= 21;
        allow create: if conversationParticipant(conversationData(conversationId))
          && request.resource.data.keys().hasAll(['id', 'senderId', 'body', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'senderId', 'body', 'createdAt'])
          && request.resource.data.id == messageId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /reports/{reportId} {
      allow get: if (signedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow list: if ((signedIn() && resource.data.reporterId == request.auth.uid) || isAdmin()) && request.query.limit <= 20;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'reporterId', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'reporterId', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.id == reportId
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['listing', 'user']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && (request.resource.data.targetType == 'listing' && exists(/databases/$(database)/documents/listings/$(request.resource.data.targetId))
          || request.resource.data.targetType == 'user' && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)))
        && request.resource.data.reason in ['spam', 'misleading', 'prohibited_item', 'harassment', 'fraud_concern', 'other']
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /auctions/{id} { allow read, write: if false; }
    match /bids/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /reviews/{id} { allow read: if true; allow write: if false; }
    match /messages/{id} { allow read, write: if false; }
    match /boosts/{id} { allow read, write: if false; }
    match /featuredListings/{id} { allow read: if true; allow write: if false; }
    match /notifications/{id} { allow read, write: if false; }
  }
}

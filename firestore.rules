rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function signedIn() { return authenticated() && !exists(/databases/$(database)/documents/accountLifecycles/$(request.auth.uid)); }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    // BEGIN GENERATED RELEASE POLICY — functions/src/release-policy.ts
    function configuredAcceptance(acceptance) {
      return acceptance.termsAcceptedAt is timestamp && acceptance.privacyAcceptedAt is timestamp
        && acceptance.age18ConfirmedAt is timestamp && acceptance.acceptanceSource == 'web'
        && (!('revokedAt' in acceptance) || acceptance.revokedAt == null)
        && ((request.auth.token.aud == 'demo-takeme' && acceptance.termsVersion == "1.0-draft"
          && acceptance.privacyVersion == "1.0-draft")
          || (request.auth.token.aud == "takeme-staging-822a5" && acceptance.termsVersion == "1.0-staging"
            && acceptance.privacyVersion == "1.0-staging")
          || false);
    }
    function configuredReleasePolicy(policy) {
      return policy.publicationApproved == true && policy.minimumAge == 18
        && policy.projectId == request.auth.token.aud
        && ((policy.releaseTarget == 'demo' && policy.projectId == 'demo-takeme'
            && policy.termsVersion == "1.0-draft" && policy.privacyVersion == "1.0-draft")
          || (policy.releaseTarget == 'staging' && policy.projectId == "takeme-staging-822a5"
            && policy.termsVersion == "1.0-staging" && policy.privacyVersion == "1.0-staging")
          || false);
    }
    function configuredStorageBucket(name) {
      return (request.auth.token.aud == "takeme-staging-822a5" && name == "takeme-staging-822a5.firebasestorage.app")
        || (request.auth.token.aud == "takeme-52b80" && name == "takeme-52b80.firebasestorage.app")
        || (request.auth.token.aud != "takeme-staging-822a5" && request.auth.token.aud != "takeme-52b80"
          && name in [request.auth.token.aud + '.appspot.com', request.auth.token.aud + '.firebasestorage.app']);
    }
    // END GENERATED RELEASE POLICY
    function marketplaceEligible() {
      let policy = get(/databases/$(database)/documents/releasePolicies/current).data;
      let acceptance = get(/databases/$(database)/documents/users/$(request.auth.uid)/private/onboarding).data;
      return signedIn() && configuredReleasePolicy(policy)
        && acceptance.termsVersion == policy.termsVersion && acceptance.privacyVersion == policy.privacyVersion
        && configuredAcceptance(acceptance);
    }
    function eligibleOwner(uid) { return owns(uid) && marketplaceEligible(); }
    function isAdmin() { return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function parentListing(listingId) { return get(/databases/$(database)/documents/listings/$(listingId)).data; }
    function transactionData(transactionId) { return get(/databases/$(database)/documents/transactions/$(transactionId)).data; }
    function transactionParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }
    function conversationParticipant(data) { return signedIn() && request.auth.uid in [data.buyerId, data.sellerId]; }
    function publicProfileSafe(data, uid) {
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['uid', 'displayName', 'photoURL', 'location'])
        && validProfileLocation(data.location)
        && data.uid == uid;
    }
    function validProfileLocation(value) {
      return value is string && (value == '' || (
        value.matches("^[A-Za-z .'-]{2,60}, (Johor|Kedah|Kelantan|Melaka|Negeri Sembilan|Pahang|Perak|Perlis|Pulau Pinang|Sabah|Sarawak|Selangor|Terengganu|W[.]P[.] Kuala Lumpur|W[.]P[.] Labuan|W[.]P[.] Putrajaya)$")
        && !value.matches('(?i).*\\b(jalan|jln|lorong|lrg|taman|tmn|persiaran|kampung|kg|no|lot|unit|blok|block|apartment|condominium|condo|residensi|residence)\\b.*')
      ));
    }
    function validGeneralLocation(value) {
      return value is map
        && value.keys().hasAll(['districtOrCity', 'state', 'country'])
        && value.keys().hasOnly(['districtOrCity', 'state', 'country'])
        && value.districtOrCity is string && value.districtOrCity.size() >= 2 && value.districtOrCity.size() <= 60
        && value.state is string && value.state.size() >= 3 && value.state.size() <= 30
        && validProfileLocation(value.districtOrCity + ', ' + value.state)
        && value.country == 'Malaysia';
    }
    function publicListingSafe(data) {
      return data.privacyVersion == 2
        && validGeneralLocation(data.publicLocation)
        && data.location == data.publicLocation.districtOrCity + ', ' + data.publicLocation.state
        && !data.keys().hasAny(['latitude', 'longitude', 'coordinates', 'gps', 'geohash', 'address', 'addressLine1', 'addressLine2', 'fullAddress', 'street', 'streetAddress', 'unitNumber', 'houseNumber', 'postcode', 'postalCode', 'privateAddress', 'exactAddress', 'preciseLocation']);
    }
    function validMeetup(data, uid) {
      return data.keys().hasAll(['ownerId', 'name', 'area', 'state', 'country', 'isDefault', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'area', 'state', 'country', 'isDefault', 'createdAt', 'updatedAt'])
        && data.ownerId == uid && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.area is string && data.area.size() >= 2 && data.area.size() <= 60
        && data.state is string && data.state.size() >= 3 && data.state.size() <= 30
        && data.country == 'Malaysia' && data.isDefault is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'location', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && (data.photoURL == null || data.photoURL is string)
        && validProfileLocation(data.location)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /accountLifecycles/{uid} { allow get: if authenticated() && request.auth.uid == uid; allow list, write: if false; }
    match /releasePolicies/{id} { allow get: if id == 'current'; allow list, write: if false; }
    match /accountDeletionOperations/{uid} { allow read, write: if false; }
    match /accountDeletionEvidence/{path=**} { allow read, write: if false; }
    match /accountDeletionSecurityHolds/{path=**} { allow read, write: if false; }

    match /users/{uid} {
      // Firestore returns complete documents: a legacy/admin-added private field
      // must not leak through the public profile path.
      allow get: if owns(uid) || (!exists(/databases/$(database)/documents/accountLifecycles/$(uid)) && publicProfileSafe(resource.data, uid));
      allow list: if false;
      allow create: if owns(uid) && validPublicProfile(request.resource.data, uid);
      allow update: if (eligibleOwner(uid)
          && validPublicProfile(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isAdmin() && marketplaceEligible());
      allow delete: if isAdmin() && marketplaceEligible();

      match /saved/{listingId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && request.query.limit <= 13;
        allow create: if eligibleOwner(uid)
          && request.resource.data.keys().hasAll(['listingId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['listingId', 'savedAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && parentListing(listingId).status == 'active';
        allow delete: if eligibleOwner(uid);
        allow update: if false;
      }
      match /meetupLocations/{meetupLocationId} {
        allow get: if owns(uid);
        allow list: if owns(uid) && request.query.limit <= 20;
        allow create: if eligibleOwner(uid) && validMeetup(request.resource.data, uid);
        allow update: if eligibleOwner(uid) && validMeetup(request.resource.data, uid)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if eligibleOwner(uid);
      }
      match /notifications/{notificationId} {
        allow read, write: if false;
      }
      match /following/{sellerId} {
        allow read, write: if false;
      }
    }

    match /privateUserAddresses/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if false;
      allow create, update: if eligibleOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'addressLine1', 'addressLine2', 'postcode', 'city', 'state', 'country', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'addressLine1', 'addressLine2', 'postcode', 'city', 'state', 'country', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.addressLine1 is string && request.resource.data.addressLine1.size() <= 160
        && request.resource.data.addressLine2 is string && request.resource.data.addressLine2.size() <= 160
        && request.resource.data.postcode is string && request.resource.data.postcode.size() <= 12
        && request.resource.data.city is string && request.resource.data.city.size() <= 80
        && request.resource.data.state is string && request.resource.data.state.size() <= 40
        && request.resource.data.country == 'Malaysia'
        && request.resource.data.updatedAt is timestamp;
      allow delete: if eligibleOwner(uid);
    }

    match /listings/{listingId} {
      allow get: if (resource.data.listingType == 'buy_now'
          && resource.data.status in ['active', 'ended', 'sold'] && publicListingSafe(resource.data))
        || (signedIn() && resource.data.sellerId == request.auth.uid
          && (resource.data.listingType == 'buy_now'
            || (resource.data.bidCount == 0 && (resource.data.status == 'draft' || resource.data.auctionStatus == 'scheduled'))))
        || isAdmin();
      // Owner history and public browsing use server-owned field projections.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && marketplaceEligible();

      match /bids/{bidId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin() && marketplaceEligible(); }
    match /favorites/{favoriteId} { allow read, write: if false; }

    match /transactions/{transactionId} {
      allow get: if transactionParticipant(resource.data) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
      match /reviews/{reviewerUid} {
        allow get: if isAdmin() || (owns(reviewerUid) && transactionParticipant(transactionData(transactionId)));
        allow list: if false;
        allow create, update, delete: if false;
      }
    }
    match /offers/{offerId} { allow read, write: if false; }
    match /offerLocks/{lockId} { allow read, write: if false; }
    match /listingDeals/{listingId} { allow read, write: if false; }
    match /publicReviews/{reviewId} { allow read, write: if false; }
    match /trustSummaries/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    // Protected-payment records are never client-authoritative. Participants and
    // administrators receive explicit safe projections through callable Functions.
    match /protectedPayments/{transactionId} { allow read, write: if false; }
    match /payouts/{transactionId} { allow read, write: if false; }
    match /refunds/{refundId} { allow read, write: if false; }
    match /sellerPaymentProfiles/{uid} { allow read, write: if false; }
    match /transactionDisputes/{transactionId} {
      allow read, write: if false;
      match /evidence/{evidenceId} { allow read, write: if false; }
    }
    match /transactionEvents/{eventId} { allow read, write: if false; }
    match /paymentProviderEvents/{eventId} { allow read, write: if false; }
    match /marketplaceEvents/{eventId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /userInterests/{uid} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /listingTrends/{listingId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /intelligenceQuotas/{quotaId} {
      allow read, write: if false;
    }
    match /discoverySessions/{sessionId} {
      allow read, write: if false;
    }
    match /intelligenceCompletions/{transactionId} {
      allow read, write: if false;
    }
    match /discoveryAttributions/{attributionId} {
      allow read, write: if false;
    }
    match /promotionPackages/{packageId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 20;
      allow create, update, delete: if isAdmin() && marketplaceEligible();
    }
    match /promotions/{promotionId} {
      allow get: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /promotionLocks/{listingId} {
      allow read, write: if false;
    }
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /auctions/{id} { allow read, write: if false; }
    match /bids/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /reviews/{id} { allow read, write: if false; }
    match /messages/{id} { allow read, write: if false; }
    match /boosts/{id} { allow read, write: if false; }
    match /featuredListings/{id} { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }
    match /notificationSummaries/{uid} { allow read, write: if false; }
    match /notificationPreferences/{uid} { allow read, write: if false; }
    match /sellerFollowers/{sellerId} {
      allow read, write: if false;
      match /members/{uid} { allow read, write: if false; }
    }
    match /sellerFollowSummaries/{sellerId} { allow read, write: if false; }
    match /savedSearches/{searchId} { allow read, write: if false; }
    match /savedSearchQuotas/{uid} { allow read, write: if false; }
    match /savedSearchFingerprints/{fingerprintId} { allow read, write: if false; }
    match /listingWatchers/{listingId} {
      allow read, write: if false;
      match /users/{uid} { allow read, write: if false; }
    }
    match /listingPriceHistory/{listingId} {
      allow read, write: if false;
      match /changes/{changeId} { allow read, write: if false; }
    }
    match /engagementJobs/{jobId} { allow read, write: if false; }
    match /engagementSchedulerCursors/{cursorId} { allow read, write: if false; }
  }
}
